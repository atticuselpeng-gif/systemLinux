#!/bin/bash
# get: download a source tarball, extract it, build it and install it.
#
# usage: get [options] URL
#        get [options] category/name   (recipe from the ports tree, see README)
#        get --sync                    refresh the ports tree
#        get --profile NAME [--root DIR] [--url BASE]
#   -p, --prefix DIR    install prefix (default: /usr/local)
#   -d, --destdir DIR   stage the install under DIR (make install DESTDIR=DIR)
#   -s, --srcdir NAME   directory inside the tarball to build (default: its only top-level directory)
#   -j, --jobs N        parallel make jobs (default: number of CPUs)
#   -c, --configure-args "ARGS"   extra arguments for ./configure
#   -k, --keep          keep the temporary work directory (default: remove it)
#   -P, --profile NAME  install a package profile (build-toolchain, common-build-deps, lang-runtimes,
#                       desktop-runtime, ...) and the profiles it requires, instead of building a tarball
#   -r, --root DIR      with --profile: unpack under DIR (default: /)
#   -u, --url BASE      with --profile: where profile-NAME.tar.xz lives
#                       (default: $GET_PROFILE_URL, or this image's GitHub release)
#   -h, --help          show this help
#
# Supported archives: .tar.gz .tgz .tar.bz2 .tbz2 .tar.xz .txz .tar
# Build: ./configure --prefix=PREFIX (when present), make, make install.
# Examples:
#   get https://ftp.gnu.org/gnu/hello/hello-2.12.tar.gz
#   get -p "$HOME/.local" https://ftp.gnu.org/gnu/hello/hello-2.12.tar.gz
#   get -d /tmp/stage -c "--disable-nls" https://example.org/foo-1.0.tar.xz
#   get --profile build-toolchain && get --profile common-build-deps
set -eu

SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
if [ -n "${GET_PORTS:-}" ]; then PORTS=$GET_PORTS
elif [ -d "${SELF%/*}/ports" ]; then PORTS=${SELF%/*}/ports
else PORTS=/usr/ports; fi
DBFILE=${GET_DB:-/var/db/get/installed}
SYNC=0 SHA='' REQUIRES='' BUILDSYS=configure
PREFIX=/usr/local DESTDIR_ARG='' SRCDIR='' JOBS='' CONFARGS='' KEEP=0 URL='' PROFILE='' ROOT=/ BASE=''
WORK=''

die() { printf 'get: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }
cleanup() {
    if [ -n "$WORK" ] && [ -d "$WORK" ]; then
        if [ "$KEEP" = 1 ]; then printf 'get: work directory kept: %s\n' "$WORK" >&2; else rm -rf "$WORK"; fi
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        -p|--prefix) [ $# -ge 2 ] || die "$1 needs an argument"; PREFIX=$2; shift 2 ;;
        -d|--destdir) [ $# -ge 2 ] || die "$1 needs an argument"; DESTDIR_ARG=$2; shift 2 ;;
        -s|--srcdir) [ $# -ge 2 ] || die "$1 needs an argument"; SRCDIR=$2; shift 2 ;;
        -j|--jobs) [ $# -ge 2 ] || die "$1 needs an argument"; JOBS=$2; shift 2 ;;
        -c|--configure-args) [ $# -ge 2 ] || die "$1 needs an argument"; CONFARGS=$2; shift 2 ;;
        -P|--profile) [ $# -ge 2 ] || die "$1 needs an argument"; PROFILE=$2; shift 2 ;;
        -r|--root) [ $# -ge 2 ] || die "$1 needs an argument"; ROOT=$2; shift 2 ;;
        -u|--url) [ $# -ge 2 ] || die "$1 needs an argument"; BASE=$2; shift 2 ;;
        --sync) SYNC=1; shift ;;
        -k|--keep) KEEP=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage >&2; die "unknown option $1" ;;
        *) break ;;
    esac
done
# fetch URL OUTFILE
fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 2 -o "$2" "$1" || return 1
    elif command -v wget >/dev/null 2>&1; then
        wget -q --tries=3 -O "$2" "$1" || return 1
    else
        die "need curl or wget to download"
    fi
}

# install_profile NAME DIR [optional]: install a profile (and, first, the ones it requires) into ROOT
install_profile() {
    case "$1" in ''|*[!A-Za-z0-9_-]*) die "invalid profile name: $1" ;; esac
    case " $DONE " in *" $1 "*) return 0 ;; esac
    DONE="$DONE $1"
    printf 'get: profile %s\n' "$1"
    if ! fetch "$BASE/profile-$1.tar.xz" "$2/p.tar.xz"; then
        [ -z "${3:-}" ] || { printf 'get: warning: required profile %s not published, skipping\n' "$1" >&2; return 0; }
        die "cannot download profile $1 from $BASE"
    fi
    fetch "$BASE/profile-$1.tar.xz.sha256" "$2/p.sha256" || die "cannot download the checksum of profile $1"
    want=$(sed -n '1s/[[:space:]].*//p' "$2/p.sha256")
    have=$(sha256sum "$2/p.tar.xz" | sed 's/[[:space:]].*//')
    if [ -z "$want" ] || [ "$want" != "$have" ]; then die "checksum mismatch for profile $1"; fi
    if fetch "$BASE/profile-$1.requires" "$2/p.requires" 2>/dev/null; then
        while read -r req; do
            [ -z "$req" ] || install_profile "$req" "$2" optional
        done < "$2/p.requires"
    fi
    mkdir -p "$ROOT"
    tar -xJf "$2/p.tar.xz" -C "$ROOT" || die "extracting profile $1 failed (run as root to install into $ROOT)"
}

if [ -n "$PROFILE" ]; then
    [ $# -eq 0 ] || die "--profile takes no URL"
    command -v tar >/dev/null 2>&1 || die "tar is required"
    command -v xz >/dev/null 2>&1 || die "xz is required"
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
    if [ -z "$BASE" ]; then
        BASE=${GET_PROFILE_URL:-}
        if [ -z "$BASE" ]; then
            VER=$(cat /usr/share/systemlinux/image-version 2>/dev/null) || die "no --url given and no image version found"
            case $VER in *.*.*) TAG=v$VER ;; *) TAG=v$VER.0 ;; esac
            BASE=https://github.com/tortr-rs/systemLinux/releases/download/$TAG
        fi
    fi
    BASE=${BASE%/}
    DONE=''
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/get.XXXXXX") || die "cannot create a work directory"
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP
    install_profile "$PROFILE" "$WORK"
    ldconfig -r "$ROOT" 2>/dev/null || true
    printf 'get: profile %s installed\n' "$PROFILE"
    exit 0
fi

# recipe_get FILE KEY: print the value of KEY (recipes are parsed, never executed)
recipe_get() { sed -n "s/^$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n1 | sed 's/[[:space:]]*$//; s/^"\(.*\)"$/\1/'; }

# resolve ATOM: set ATOM, URL, SHA, REQUIRES, BUILDSYS and CONFARGS from the ports tree
resolve() {
    case "$1" in
        ''|*[!A-Za-z0-9._+/-]*|*..*|/*) die "invalid package atom: $1" ;;
        */*) dir=$PORTS/$1 ;;
        *)
            set -- "$1" $(ls -d "$PORTS"/*/"$1" 2>/dev/null)
            [ $# -le 2 ] || { shift; die "ambiguous name, use category/name: $(printf '%s ' "$@" | sed "s|$PORTS/||g")"; }
            dir=${2:-} ;;
    esac
    [ -n "$dir" ] && [ -f "$dir/recipe" ] || die "unknown package '$1' (try: get --sync)"
    ATOM=${dir#"$PORTS"/}
    URL=$(recipe_get "$dir/recipe" url)
    SHA=$(recipe_get "$dir/recipe" sha256)
    REQUIRES=$(recipe_get "$dir/recipe" requires)
    b=$(recipe_get "$dir/recipe" build)
    case "$b" in ''|configure|cmake|meson) BUILDSYS=${b:-configure} ;; *) die "unsupported build type: $b" ;; esac
    ca=$(recipe_get "$dir/recipe" configure_args)
    if [ -n "$ca" ]; then CONFARGS="$ca${CONFARGS:+ $CONFARGS}"; fi
    case "$REQUIRES" in *[!A-Za-z0-9._+/\ -]*) die "invalid requires in $ATOM" ;; esac
    [ -n "$URL" ] || [ -n "$REQUIRES" ] || die "recipe $ATOM has neither url nor requires"
}

is_installed() { [ -r "$DBFILE" ] && grep -qxF "$1" "$DBFILE"; }
mark_installed() {
    mkdir -p "$(dirname "$DBFILE")" 2>/dev/null || return 0
    echo "$1" >> "$DBFILE" 2>/dev/null || printf 'get: warning: cannot record %s in %s\n' "$1" "$DBFILE" >&2
}

if [ "$SYNC" = 1 ]; then
    if [ -d "$PORTS/.git" ] || git -C "$PORTS" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$PORTS" pull --ff-only || die "git pull failed in $PORTS"
    else
        # tarball + detached .sha256, published with every release (default: the latest one)
        GET_PORTS_URL=${GET_PORTS_URL:-https://github.com/tortr-rs/systemLinux/releases/latest/download/ports.tar.xz}
        command -v tar >/dev/null 2>&1 && command -v sha256sum >/dev/null 2>&1 || die "tar and sha256sum are required"
        WORK=$(mktemp -d "${TMPDIR:-/tmp}/get.XXXXXX") || die "cannot create a work directory"
        trap cleanup EXIT
        fetch "$GET_PORTS_URL" "$WORK/ports.tar.xz" || die "cannot download $GET_PORTS_URL"
        fetch "$GET_PORTS_URL.sha256" "$WORK/ports.sha256" || die "cannot download the ports checksum"
        want=$(sed -n '1s/[[:space:]].*//p' "$WORK/ports.sha256")
        have=$(sha256sum "$WORK/ports.tar.xz" | sed 's/[[:space:]].*//')
        [ -n "$want" ] && [ "$want" = "$have" ] || die "ports checksum mismatch"
        mkdir -p "$WORK/new"
        tar --no-same-owner -xJf "$WORK/ports.tar.xz" -C "$WORK/new" --strip-components=1 || die "extracting ports failed"
        [ -n "$(ls "$WORK/new")" ] || die "the downloaded ports tree is empty"
        # replace the tree, so recipes removed upstream go away too
        mkdir -p "$PORTS" && rm -rf "${PORTS:?}"/* && cp -a "$WORK/new/." "$PORTS/" || die "cannot update $PORTS"
    fi
    printf 'get: ports synced (%s)\n' "$PORTS"
    exit 0
fi
[ $# -ge 1 ] || { usage >&2; exit 2; }
URL=$1; shift
ATOM=''
[ $# -eq 0 ] || die "only one URL is accepted"

case "$URL" in
    *://*) ;;
    *) resolve "$URL" ;;
esac
case "$JOBS" in
    ''|*[!0-9]*) [ -z "$JOBS" ] || die "--jobs needs a number" ;;
esac
[ -n "$JOBS" ] || JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)

if [ -n "$ATOM" ]; then
    if is_installed "$ATOM"; then printf 'get: %s already installed\n' "$ATOM"; exit 0; fi
    case ":${GET_STACK:-}:" in *":$ATOM:"*) die "dependency cycle: ${GET_STACK#:} -> $ATOM" ;; esac
    export GET_STACK="${GET_STACK:+$GET_STACK:}$ATOM"
    for r in $REQUIRES; do
        "$SELF" -p "$PREFIX" -j "$JOBS" ${DESTDIR_ARG:+-d "$DESTDIR_ARG"} "$r" || die "dependency $r failed"
    done
    if [ -z "$URL" ]; then mark_installed "$ATOM"; printf 'get: %s (meta-package) done\n' "$ATOM"; exit 0; fi
fi

case "$URL" in
    https://*) ;;
    http://*|ftp://*) printf 'get: warning: %s is not encrypted\n' "$URL" >&2; [ -n "$SHA" ] || printf 'get: warning: source is not verified\n' >&2 ;;
    *) die "not a URL: $URL" ;;
esac

file=${URL%%[?#]*}
file=${file##*/}
case "$file" in
    *.tar.gz|*.tgz) FLAG=z ;;
    *.tar.bz2|*.tbz2) FLAG=j ;;
    *.tar.xz|*.txz) FLAG=J ;;
    *.tar) FLAG= ;;
    *) die "unsupported archive format: ${file:-$URL} (supported: .tar.gz .tgz .tar.bz2 .tar.xz .tar)" ;;
esac

command -v make >/dev/null 2>&1 || die "make is required"
command -v tar >/dev/null 2>&1 || die "tar is required"

WORK=$(mktemp -d "${TMPDIR:-/tmp}/get.XXXXXX") || die "cannot create a work directory"
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

printf 'get: downloading %s\n' "$URL"
fetch "$URL" "$WORK/$file" || die "download failed"

if [ -n "$SHA" ]; then
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required to verify $file"
    have=$(sha256sum "$WORK/$file" | sed 's/[[:space:]].*//')
    [ "$have" = "$SHA" ] || die "checksum mismatch for $file"
fi

printf 'get: extracting %s\n' "$file"
mkdir "$WORK/src"
if [ -n "$FLAG" ]; then
    tar --no-same-owner -x"$FLAG"f "$WORK/$file" -C "$WORK/src" || die "extraction failed"
else
    tar --no-same-owner -xf "$WORK/$file" -C "$WORK/src" || die "extraction failed"
fi

if [ -n "$SRCDIR" ]; then
    case "$SRCDIR" in /*|..|../*|*/../*|*/..) die "--srcdir must be a relative path inside the archive" ;; esac
    BUILD=$WORK/src/$SRCDIR
else
    BUILD=$WORK/src
    set -- "$WORK"/src/*
    if [ $# -eq 1 ] && [ -d "$1" ]; then BUILD=$1; fi
fi
[ -d "$BUILD" ] || die "source directory not found: ${SRCDIR:-$BUILD}"
cd "$BUILD"

MAKEVARS=''
case "$BUILDSYS" in
cmake)
    command -v cmake >/dev/null 2>&1 || die "cmake is required (get dev-apps/cmake)"
    printf 'get: cmake (prefix %s)\n' "$PREFIX"
    read -r -a CONFARGS_ARRAY <<< "$CONFARGS"
    cmake -S . -B build -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_BUILD_TYPE=Release "${CONFARGS_ARRAY[@]}" || die "cmake configure failed"
    cmake --build build -j "$JOBS" || die "cmake build failed"
    DESTDIR=${DESTDIR_ARG:-} cmake --install build || die "cmake install failed"
    ;;
meson)
    command -v meson >/dev/null 2>&1 || die "meson is required (get dev-apps/meson)"
    printf 'get: meson (prefix %s)\n' "$PREFIX"
    read -r -a CONFARGS_ARRAY <<< "$CONFARGS"
    meson setup build --prefix="$PREFIX" "${CONFARGS_ARRAY[@]}" || die "meson setup failed"
    meson compile -C build -j "$JOBS" || die "meson compile failed"
    DESTDIR=${DESTDIR_ARG:-} meson install -C build || die "meson install failed"
    ;;
*)
    if [ -x ./configure ]; then
        printf 'get: configure --prefix=%s\n' "$PREFIX"
        # Split CONFARGS into array to preserve quoted arguments
        # shellcheck disable=SC2206
        CONFARGS_ARRAY=($CONFARGS)
        ./configure --prefix="$PREFIX" "${CONFARGS_ARRAY[@]}" || die "configure failed"
    else
        MAKEVARS="PREFIX=$PREFIX"
    fi

    [ -f Makefile ] || [ -f makefile ] || [ -f GNUmakefile ] || die "no Makefile found (and no configure script to create one)"
    printf 'get: make -j%s\n' "$JOBS"
    # shellcheck disable=SC2086
    make -j"$JOBS" ${MAKEVARS:+"$MAKEVARS"} || die "make failed"

    printf 'get: make install (prefix %s%s)\n' "$PREFIX" "${DESTDIR_ARG:+, staged in $DESTDIR_ARG}"
    if [ -n "$DESTDIR_ARG" ]; then
        mkdir -p "$DESTDIR_ARG"
        # shellcheck disable=SC2086
        make install DESTDIR="$DESTDIR_ARG" ${MAKEVARS:+"$MAKEVARS"} || die "make install failed"
    else
        # shellcheck disable=SC2086
        make install ${MAKEVARS:+"$MAKEVARS"} || die "make install failed (try again with sudo, or a --prefix you can write to)"
    fi
    ;;
esac
[ -z "$ATOM" ] || mark_installed "$ATOM"
# new shared libraries (e.g. in /usr/local/lib) are only found after the linker cache is refreshed
if [ -z "${DESTDIR_ARG:-}" ] && [ "$(id -u)" = 0 ]; then ldconfig 2>/dev/null || true; fi
printf 'get: done\n'
