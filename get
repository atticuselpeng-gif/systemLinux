#!/bin/bash
# get: the systemLinux package tool. Builds packages from source and keeps track of them.
#
# usage: get install NAME...       build and install NAME and everything it needs
#        get remove NAME...        uninstall NAME (refused while another package needs it)
#        get autoremove            remove dependencies nothing needs any more
#        get list                  installed packages (* = installed on request, not as a dependency)
#        get search WORD           find packages in the ports tree
#        get info NAME             recipe, dependencies and install status
#        get files NAME            files an installed package owns
#        get sync                  update the ports tree from the latest release
#        get install URL           build a source tarball that has no recipe
#        get profile NAME          unpack a prebuilt package profile (see profiles/README)
#   -f, --force    install even if already installed / the base system provides it; remove even if needed
#   -j N           parallel build jobs (default: number of CPUs)
#   -k, --keep     keep the build directory
#   -h, --help     this help
#
# NAME is a port name (fastfetch) or category/name (text/fastfetch). Dependencies are resolved from the
# recipes' `requires`; anything the base system already provides is not rebuilt. The build system is taken
# from the recipe or detected (configure, autotools, cmake, meson, make, ...). Packages are installed into /usr
# (configuration in /etc), like the base system. Every installed file is recorded, and the base system's files are
# recorded too (as base/NAME), so a package never silently overwrites another one's files; a port replaces the base
# package of the same name in place. `get remove` deletes exactly what was installed.
# Writing a recipe: docs/PACKAGING.md
set -eu

SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
if [ -n "${GET_PORTS:-}" ]; then PORTS=$GET_PORTS
elif [ -d "${SELF%/*}/ports" ]; then PORTS=${SELF%/*}/ports
else PORTS=/usr/ports; fi
PREFIX=${GET_PREFIX:-/usr}
if [ "$PREFIX" = /usr ]; then SYSCONFDIR=/etc LOCALSTATEDIR=/var; else SYSCONFDIR=$PREFIX/etc LOCALSTATEDIR=$PREFIX/var; fi
DB=${GET_DB:-/var/db/get}
BASE_LIST=${GET_BASE_LIST:-/usr/share/systemlinux/base-packages}
PORTS_URL=${GET_PORTS_URL:-https://github.com/tortr-rs/systemLinux/releases/latest/download/ports.tar.xz}
FORCE=0 KEEP=0 JOBS=''
WORK=''

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf 'get: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,24p' "$SELF" | sed 's/^# \{0,1\}//'; }
cleanup() {
    if [ -n "$WORK" ] && [ -d "$WORK" ]; then
        if [ "$KEEP" = 1 ]; then printf 'get: build directory kept: %s\n' "$WORK" >&2; else rm -rf "$WORK"; fi
    fi
}
need_root() { [ "$(id -u)" = 0 ] || [ -n "${GET_PREFIX:-}" ] || die "$1 needs root (try: sudo get $CMD ...)"; }
newwork() { WORK=$(mktemp -d "${TMPDIR:-/tmp}/get.XXXXXX") || die "cannot create a build directory"; trap cleanup EXIT; trap 'exit 130' INT TERM HUP; }

fetch() {
    if command -v curl >/dev/null 2>&1; then curl -fL --retry 2 --progress-bar -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then wget -q --show-progress --tries=3 -O "$2" "$1"
    else die "need curl or wget to download"; fi
}
quietfetch() {
    if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 2 -o "$2" "$1"; else wget -q --tries=3 -O "$2" "$1"; fi
}

# ---- ports tree and package database ----
recipe_get() { sed -n "s/^$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n1 | sed 's/[[:space:]]*$//; s/^"\(.*\)"$/\1/'; }

# atom NAME: print category/name for a port name or atom
atom() {
    case "$1" in ''|*[!A-Za-z0-9._+/-]*|*..*|/*) die "invalid package name: $1" ;; esac
    local m
    case "$1" in
        */*) [ -f "$PORTS/$1/recipe" ] || die "unknown package '$1' (try: get sync, or get search)"; echo "$1" ;;
        *)   m=$(cd "$PORTS" 2>/dev/null && ls -d */"$1" 2>/dev/null) || true
             [ -n "$m" ] || die "unknown package '$1' (try: get sync, or get search)"
             [ "$(echo "$m" | wc -l)" = 1 ] || die "'$1' is ambiguous, use one of: $(echo $m)"
             echo "$m" ;;
    esac
}
dbdir() { echo "$DB/pkgs/${1//\//__}"; }
installed() { [ -f "$(dbdir "$1")/files" ]; }
# provided_by_base ATOM: the system already has this package. A recipe's `check` (pkgconfig:NAME, cmd:NAME,
# file:/PATH, python:MODULE or perl:Module::Name) decides when present, so a base package built without a needed feature is not mistaken for enough;
# otherwise the base image's package list does.
provided_by_base() {
    local c; c=$(recipe_get "$PORTS/$1/recipe" check 2>/dev/null)
    case "$c" in
        pkgconfig:*) pkg-config --exists "${c#pkgconfig:}" 2>/dev/null; return ;;
        cmd:*)       command -v "${c#cmd:}" >/dev/null 2>&1; return ;;
        file:/*)     [ -e "${c#file:}" ]; return ;;
        python:*)    case "${c#python:}" in *[!A-Za-z0-9_.]*) return 1 ;; esac; python3 -c "import ${c#python:}" 2>/dev/null; return ;;
        perl:*)      case "${c#perl:}" in *[!A-Za-z0-9_:]*) return 1 ;; esac; perl -M"${c#perl:}" -e 1 2>/dev/null; return ;;
    esac
    [ -f "$DB/pkgs/base__${1##*/}/files" ] || { [ -r "$BASE_LIST" ] && grep -qxF "${1##*/}" "$BASE_LIST"; }
}
requires_of() { recipe_get "$PORTS/$1/recipe" requires; }
# installed packages, not counting the base system's (base/NAME)
installed_atoms() { [ -d "$DB/pkgs" ] && for d in "$DB"/pkgs/*/; do case "$d" in */base__*/) continue ;; esac; [ -f "$d/files" ] && basename "$d" | sed 's|__|/|'; done; true; }

# ---- dependency resolution: ORDER gets every atom to build, dependencies first ----
ORDER='' VISITING=''
visit() {
    local a=$1 r
    case " $ORDER " in *" $a "*) return 0 ;; esac
    case " $VISITING " in *" $a "*) die "dependency cycle through $a" ;; esac
    VISITING="$VISITING $a"
    for r in $(requires_of "$a"); do
        r=$(atom "$r")
        # satisfied already: skip it and everything below it
        if installed "$r" || provided_by_base "$r"; then continue; fi
        visit "$r"
    done
    VISITING=${VISITING% "$a"}
    ORDER="$ORDER $a"
}

# ---- building ----
# build_and_stage NAME URL SHA BUILDSYS CONFARGS [PORTDIR SRCDIR MAKEARGS PROGRAMS]: build in WORK, install into
# $WORK/dest
build_and_stage() {
    local name=$1 url=$2 sha=$3 buildsys=$4 confargs=$5 portdir=${6:-} srcdir=${7:-} makeargs=${8:-} programs=${9:-}
    local file flag src p
    case "$url" in
        https://*) ;;
        http://*|ftp://*) printf 'get: warning: %s is not encrypted\n' "$url" >&2 ;;
        *) die "not a URL: $url" ;;
    esac
    file=${url%%[?#]*}; file=${file##*/}
    case "$file" in
        *.tar.gz|*.tgz) flag=z ;; *.tar.bz2|*.tbz2|*.tbz) flag=j ;; *.tar.xz|*.txz) flag=J ;;
        *.tar.zst) flag=--zstd ;; *.tar) flag='' ;;
        *.zip) flag=zip ;;
        *) # prebuilt ports may download a single program (kubectl, foo.AppImage, foo.gz)
           case "$buildsys" in bin|script) flag=file ;; *) die "unsupported archive: $file" ;; esac ;;
    esac
    say "downloading $file"
    fetch "$url" "$WORK/$file" || die "download failed: $url"
    if [ -n "$sha" ]; then
        [ "$(sha256sum "$WORK/$file" | cut -d' ' -f1)" = "$sha" ] || die "checksum mismatch for $file"
    else
        printf 'get: warning: %s has no checksum in its recipe\n' "${name:-$file}" >&2
    fi
    mkdir "$WORK/src"
    case "$flag" in
        zip)    unzip -q "$WORK/$file" -d "$WORK/src" ;;
        file)   case "$file" in
                    *.gz)  gzip -dc "$WORK/$file" > "$WORK/src/${file%.gz}" && chmod 755 "$WORK/src/${file%.gz}" ;;
                    *.bz2) bzip2 -dc "$WORK/$file" > "$WORK/src/${file%.bz2}" && chmod 755 "$WORK/src/${file%.bz2}" ;;
                    *.xz)  xz -dc "$WORK/$file" > "$WORK/src/${file%.xz}" && chmod 755 "$WORK/src/${file%.xz}" ;;
                    *)     install -m755 "$WORK/$file" "$WORK/src/$file" ;;
                esac ;;
        --zstd) tar --no-same-owner --zstd -xf "$WORK/$file" -C "$WORK/src" ;;
        '')     tar --no-same-owner -xf "$WORK/$file" -C "$WORK/src" ;;
        *)      tar --no-same-owner -x"$flag"f "$WORK/$file" -C "$WORK/src" ;;
    esac || die "extracting $file failed"
    src=$WORK/src
    set -- "$WORK"/src/*
    if [ $# -eq 1 ] && [ -d "$1" ]; then src=$1; fi
    if [ -n "$srcdir" ]; then
        case "$srcdir" in /*|..|../*|*/../*|*/..) die "srcdir must stay inside the source tree" ;; esac
        src=$src/$srcdir
        [ -d "$src" ] || die "srcdir $srcdir not found in $file"
    fi
    cd "$src"
    # the port's patches, in name order
    if [ -n "$portdir" ] && [ -d "$portdir/patches" ]; then
        for p in "$portdir"/patches/*.patch; do
            [ -f "$p" ] || continue
            say "applying ${p##*/}"
            patch -p1 -N -s < "$p" || die "patch ${p##*/} failed"
        done
    fi

    # detect the build system when the recipe does not name one
    if [ -z "$buildsys" ]; then
        if [ -x ./configure ]; then buildsys=configure
        elif [ -f meson.build ]; then buildsys=meson
        elif [ -f CMakeLists.txt ]; then buildsys=cmake
        elif [ -f configure.ac ] || [ -f configure.in ]; then buildsys=autotools
        elif [ -f Makefile ] || [ -f makefile ] || [ -f GNUmakefile ]; then buildsys=make
        elif [ -f pyproject.toml ] || [ -f setup.py ]; then buildsys=python
        elif [ -f Cargo.toml ]; then buildsys=cargo
        elif [ -f go.mod ]; then buildsys=go
        elif [ -f Makefile.PL ]; then buildsys=perl
        elif [ -n "$portdir" ] && [ -f "$portdir/build.sh" ]; then buildsys=script
        else die "cannot tell how to build ${name:-$file} (no configure, meson.build, CMakeLists.txt or Makefile)"; fi
    fi
    local args=() margs=()
    read -r -a args <<< "$confargs"
    read -r -a margs <<< "$makeargs"
    local dest=$WORK/dest
    mkdir -p "$dest"
    say "building ${name:-$file} ($buildsys, $JOBS jobs)"
    case "$buildsys" in
        cmake)
            cmake -S . -B _build -G "$(command -v ninja >/dev/null && echo Ninja || echo 'Unix Makefiles')" \
                -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_INSTALL_LIBDIR=lib64 -DCMAKE_INSTALL_SYSCONFDIR="$SYSCONFDIR" \
                -DCMAKE_INSTALL_LOCALSTATEDIR="$LOCALSTATEDIR" -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH="$PREFIX" \
                -DBUILD_TESTING=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5 "${args[@]}" || die "cmake configure failed"
            cmake --build _build -j "$JOBS" || die "build failed"
            DESTDIR=$dest cmake --install _build || die "install failed" ;;
        meson)
            meson setup _build --prefix="$PREFIX" --libdir=lib64 --sysconfdir="$SYSCONFDIR" \
                --localstatedir="$LOCALSTATEDIR" --buildtype=release "${args[@]}" || die "meson setup failed"
            meson compile -C _build -j "$JOBS" || die "build failed"
            DESTDIR=$dest meson install -C _build --no-rebuild || die "install failed" ;;
        autotools|configure)
            if [ "$buildsys" = autotools ] || [ ! -x ./configure ]; then
                if [ -x ./autogen.sh ]; then NOCONFIGURE=1 ./autogen.sh || die "autogen.sh failed"
                else autoreconf -fi || die "autoreconf failed"; fi
            fi
            # the standard directories, for configure scripts that know them (not every one is from autoconf)
            local dirs=() h; h=$(./configure --help 2>/dev/null || true)
            case "$h" in *--libdir*) dirs+=(--libdir="$PREFIX/lib64") ;; esac
            case "$h" in *--sysconfdir*) dirs+=(--sysconfdir="$SYSCONFDIR") ;; esac
            case "$h" in *--localstatedir*) dirs+=(--localstatedir="$LOCALSTATEDIR") ;; esac
            ./configure --prefix="$PREFIX" "${dirs[@]}" "${args[@]}" || die "configure failed"
            make -j"$JOBS" "${margs[@]}" || die "build failed"
            make install DESTDIR="$dest" "${margs[@]}" || die "install failed" ;;
        make)
            make -j"$JOBS" PREFIX="$PREFIX" prefix="$PREFIX" "${args[@]}" "${margs[@]}" || die "build failed"
            make install DESTDIR="$dest" PREFIX="$PREFIX" prefix="$PREFIX" "${args[@]}" "${margs[@]}" || die "install failed" ;;
        python)
            # the base system's gpep517 + installer (as Gentoo builds Python packages): build a wheel with the project's
            # own build backend, then install it; pip (installed, or the copy bundled with Python) when gpep517 is missing
            local pip=(python3 -m pip) whl backend
            if python3 -c 'import gpep517, installer' 2>/dev/null; then
                backend=$(python3 -m gpep517 get-backend) || die "cannot read the build backend from pyproject.toml"
                [ -n "$backend" ] || backend=setuptools.build_meta:__legacy__   # a plain setup.py project
                mkdir -p "$WORK/wheel"
                python3 -m gpep517 build-wheel --backend "$backend" --wheel-dir "$WORK/wheel" --output-fd 3 "${args[@]}" \
                    3> "$WORK/wheel.name" || die "python build failed"
                python3 -m gpep517 install-wheel --destdir "$dest" --prefix "$PREFIX" "$WORK/wheel/$(cat "$WORK/wheel.name")" \
                    || die "installing the wheel failed"
            else
                if ! python3 -m pip --version >/dev/null 2>&1; then
                    whl=$(python3 -c 'import ensurepip, glob, os; print(sorted(glob.glob(os.path.join(os.path.dirname(ensurepip.__file__), "_bundled", "pip-*.whl")))[-1])' 2>/dev/null) \
                        || die "python builds need gpep517 or pip"
                    pip=(python3 "$whl/pip")
                fi
                "${pip[@]}" install --no-deps --no-build-isolation --no-warn-script-location --disable-pip-version-check \
                    --prefix="$PREFIX" --root="$dest" "${args[@]}" . || die "python build failed"
            fi ;;
        cargo)
            command -v cargo >/dev/null || die "cargo builds need Rust (get install rust)"
            # a workspace without a package of its own: build the member crate named like the port
            local crate=.
            if grep -q '^\[workspace\]' Cargo.toml && ! grep -q '^\[package\]' Cargo.toml; then
                # (a crate or a [[bin]] with that name; a library crate is skipped)
                local c; crate=''
                for c in $(grep -lE "^name[[:space:]]*=[[:space:]]*\"${name##*/}\"" */Cargo.toml */*/Cargo.toml 2>/dev/null); do
                    if grep -q '^\[\[bin\]\]' "$c" || [ -f "${c%/Cargo.toml}/src/main.rs" ]; then crate=${c%/Cargo.toml}; break; fi
                done
                [ -n "$crate" ] || die "${name##*/}: Cargo workspace with no program named ${name##*/} (set srcdir in the recipe)"
            fi
            cargo install --locked --no-track --path "$crate" --root "$dest$PREFIX" "${args[@]}" || die "cargo build failed" ;;
        go) # make_args names the packages to build (default: every main package, ./...)
            command -v go >/dev/null || die "go builds need Go (get install go)"
            mkdir -p "$dest$PREFIX/bin"
            [ ${#margs[@]} -gt 0 ] || margs=(./...)
            # a project that needs a newer Go than the installed one gets it from Go's checksummed toolchain downloads
            GOTOOLCHAIN=auto go build -trimpath -o "$dest$PREFIX/bin/" "${args[@]}" "${margs[@]}" || die "go build failed" ;;
        bin) # an upstream prebuilt release (see install_prebuilt)
            install_prebuilt "$dest" "${name##*/}" "$programs" ;;
        script) # the port's build.sh does everything; it installs into $DESTDIR$PREFIX
            [ -n "$portdir" ] && [ -f "$portdir/build.sh" ] || die "build=script needs a build.sh in the port"
            DESTDIR=$dest PREFIX=$PREFIX SYSCONFDIR=$SYSCONFDIR LOCALSTATEDIR=$LOCALSTATEDIR JOBS=$JOBS PORTDIR=$portdir bash -e "$portdir/build.sh" "${args[@]}" || die "build.sh failed" ;;
        fonts) # no build system: install every font file found
            mkdir -p "$dest$PREFIX/share/fonts/${name##*/}"
            find . -type f \( -name '*.ttf' -o -name '*.otf' -o -name '*.ttc' -o -name '*.pcf.gz' \) \
                -exec install -m644 {} "$dest$PREFIX/share/fonts/${name##*/}/" \; ;;
        perl)
            perl Makefile.PL PREFIX="$PREFIX" INSTALLDIRS=vendor "${args[@]}" || die "Makefile.PL failed"
            make -j"$JOBS" "${margs[@]}" || die "build failed"
            make install DESTDIR="$dest" "${margs[@]}" || die "install failed" ;;
        *) die "unknown build type: $buildsys" ;;
    esac
    # dinit services and extra files that come with the port
    if [ -n "$portdir" ] && [ -d "$portdir/dinit" ]; then
        mkdir -p "$dest/etc/dinit.d"
        cp -r "$portdir/dinit/." "$dest/etc/dinit.d/"
    fi
    if [ -n "$portdir" ] && [ -d "$portdir/files" ]; then cp -r "$portdir/files/." "$dest/"; fi
    cd /
}

# usrmerge DIR: move a staged /bin, /sbin, /lib, /lib64 and /usr/sbin into /usr (on systemLinux those are symlinks
# into /usr, and copying a real directory over them would fail)
usrmerge() {
    local d from to
    for d in bin:usr/bin sbin:usr/bin usr/sbin:usr/bin lib:usr/lib lib64:usr/lib64; do
        from=$1/${d%%:*} to=$1/${d#*:}
        [ -d "$from" ] && [ ! -L "$from" ] || continue
        mkdir -p "$to" && cp -a "$from/." "$to/" && rm -rf "$from" || die "cannot move ${d%%:*} into ${d#*:}"
    done
}

# install_prebuilt DEST NAME PROGRAMS: install an upstream prebuilt release from the current directory.
#  - PROGRAMS given ("path[:name] ..."): the whole tree goes to $PREFIX/lib/NAME (NAME without -bin) and each
#    program is linked into $PREFIX/bin;
#  - an AppImage: it is unpacked (no FUSE needed) to $PREFIX/lib/NAME and its AppRun is linked as NAME;
#  - otherwise every executable goes to $PREFIX/bin, with the man pages and shell completions found next to it.
install_prebuilt() {
    local dest=$1 app=${2%-bin} progs=$3 p path link f n
    local lib=$dest$PREFIX/lib/$app bin=$dest$PREFIX/bin
    mkdir -p "$bin"
    f=$(find . -maxdepth 2 -type f -name '*.AppImage' | head -n1)
    if [ -z "$progs" ] && [ -n "$f" ]; then
        chmod 755 "$f"
        (cd "$(dirname "$f")" && "./$(basename "$f")" --appimage-extract >/dev/null) || die "cannot unpack ${f##*/}"
        mkdir -p "$lib" && cp -a "$(dirname "$f")/squashfs-root/." "$lib/"
        chmod -R a+rX "$lib"
        ln -s "../lib/$app/AppRun" "$bin/$app"
        # its desktop entry and icon, pointed at the installed program
        for n in "$lib"/*.desktop; do
            [ -f "$n" ] || continue
            mkdir -p "$dest$PREFIX/share/applications"
            sed -e "s|^Exec=[^ ]*|Exec=$app|" -e "s|^TryExec=.*||" "$n" > "$dest$PREFIX/share/applications/$app.desktop"
            break
        done
        for n in "$lib"/.DirIcon "$lib"/*.png "$lib"/*.svg; do
            [ -f "$n" ] || continue
            case "$n" in *.svg) mkdir -p "$dest$PREFIX/share/icons/hicolor/scalable/apps"; cp -L "$n" "$dest$PREFIX/share/icons/hicolor/scalable/apps/" ;;
                         *.png) mkdir -p "$dest$PREFIX/share/pixmaps"; cp -L "$n" "$dest$PREFIX/share/pixmaps/" ;; esac
        done
        return 0
    fi
    if [ -n "$progs" ]; then
        mkdir -p "$lib" && cp -a . "$lib/"
        for p in $progs; do
            path=${p%%:*}; link=${p#*:}; [ "$link" != "$p" ] || link=${path##*/}
            case "$path" in /*|*..*) die "programs: $path must be a path inside the archive" ;; esac
            [ -e "$lib/$path" ] || die "programs: $path is not in the archive"
            ln -sf "../lib/$app/$path" "$bin/$link"
        done
        return 0
    fi
    n=0
    while IFS= read -r f; do
        case "${f##*/}" in *.so|*.so.*|*.sh|*.ps1|*.bat|*.exe|*.dll|*.txt|*.md|LICENSE*|COPYING*|README*) continue ;; esac
        # a platform-named download (yq_linux_amd64, restic_0.18.0_linux_amd64) is installed under the port's name
        p=${f##*/}; case "$p" in *[Ll]inux*|*amd64*|*x86_64*|*x86-64*|*x64*) p=$app ;; esac
        install -m755 "$f" "$bin/$p"; n=$((n + 1))
    done < <(find . -type f -perm -u+x ! -path '*/complet*' ! -path '*/autocomplete/*' ! -path '*/doc/*' ! -path '*/man/*')
    [ "$n" -gt 0 ] || die "$app: no program found in the archive (set programs= in the recipe)"
    while IFS= read -r f; do
        p=${f%.gz}; p=${p##*.}
        install -Dm644 "$f" "$dest$PREFIX/share/man/man$p/${f##*/}"
    done < <(find . -type f \( -name '*.[1-8]' -o -name '*.[1-8].gz' \))
    while IFS= read -r f; do
        case "$f" in
            *.bash|*/bash/*) install -Dm644 "$f" "$dest$PREFIX/share/bash-completion/completions/$app" ;;
            *.fish)          install -Dm644 "$f" "$dest$PREFIX/share/fish/vendor_completions.d/$app.fish" ;;
            */_*)            install -Dm644 "$f" "$dest$PREFIX/share/zsh/site-functions/${f##*/}" ;;
        esac
    done < <(find . -type f \( -path '*/complet*' -o -path '*/autocomplete/*' \))
}

# merge ATOM-or-NAME: copy $WORK/dest into / and record every file.
# A file another package owns is refused (-f takes it over), except that a port takes over the files of the base
# package with the same name: it replaces that base package in place. Files of the base package that the port does
# not install stay with the base package. Configuration in /etc that exists and is not this package's is kept; the
# new version is installed next to it as FILE.get-new.
merge() {
    local key=$1 dir f owner p bad='' took=''
    dir=$(dbdir "$key")
    usrmerge "$WORK/dest"
    # indexes shared by many packages are not package files: they are regenerated after installing (refresh_caches)
    find "$WORK/dest" \( -path '*/share/info/dir' -o -name charset.alias -o -name perllocal.pod -o -name icon-theme.cache \
        -o -name gschemas.compiled -o -name mimeinfo.cache \) -delete
    (cd "$WORK/dest" && find . \( -type f -o -type l \) | sed 's|^\.||' | sort) > "$WORK/files"
    [ -s "$WORK/files" ] || die "$key installed no files"
    # keep existing configuration
    while IFS= read -r f; do
        case "$f" in /etc/*) ;; *) continue ;; esac
        [ -e "$f" ] || [ -L "$f" ] || continue
        if [ -f "$dir/files" ] && grep -qxF "$f" "$dir/files"; then continue; fi
        cmp -s "$f" "$WORK/dest$f" && continue
        mv "$WORK/dest$f" "$WORK/dest$f.get-new"
        printf 'get: kept your %s; the new version is %s.get-new\n' "$f" "$f" >&2
    done < "$WORK/files"
    (cd "$WORK/dest" && find . \( -type f -o -type l \) | sed 's|^\.||' | sort) > "$WORK/files"
    # who owns the files already: "owner-dir<TAB>path"
    : > "$WORK/owners"
    for p in "$DB"/pkgs/*/files; do
        [ -f "$p" ] && [ "$p" != "$dir/files" ] || continue
        grep -xF -f "$WORK/files" "$p" 2>/dev/null | sed "s|^|${p%/files}\t|" >> "$WORK/owners" || true
    done
    while IFS=$'\t' read -r owner f; do
        case "${owner##*/}" in "base__${key##*/}") took=base/${key##*/}; continue ;; esac
        [ "$FORCE" = 1 ] && continue
        bad="$f already belongs to $(basename "$owner" | sed 's|__|/|') (use -f to overwrite)"; break
    done < "$WORK/owners"
    [ -z "$bad" ] || die "$bad"
    # the old version's files that the new one no longer has
    if [ -f "$dir/files" ]; then
        comm -23 <(sort "$dir/files") "$WORK/files" | while IFS= read -r f; do rm -f "$f"; done
    fi
    cp -a "$WORK/dest/." / || die "copying files into place failed"
    # the files taken over now belong to this package only
    cut -f1 "$WORK/owners" | sort -u | while IFS= read -r owner; do
        grep -vxF -f "$WORK/files" "$owner/files" > "$owner/files.new" || true
        mv "$owner/files.new" "$owner/files"
    done
    mkdir -p "$dir"
    cp "$WORK/files" "$dir/files"
    if [ -n "$took" ]; then echo "$took" > "$dir/replaces"; say "replaced the base system's ${took#base/}"; fi
    refresh_caches "$WORK/files"
}

# refresh_caches FILELIST: rebuild the system indexes that the listed (installed or removed) files belong to
refresh_caches() {
    local f d
    ldconfig 2>/dev/null || true
    if grep -q '/share/fonts/' "$1"; then fc-cache -f >/dev/null 2>&1 || true; fi
    if command -v install-info >/dev/null; then
        grep -E '/share/info/[^/]+\.info(\.gz)?$' "$1" | while IFS= read -r f; do
            if [ -e "$f" ]; then install-info "$f" "${f%/*}/dir" >/dev/null 2>&1; else install-info --delete "$f" "${f%/*}/dir" >/dev/null 2>&1; fi
        done || true
    fi
    grep -o '^/[^ ]*/share/icons/[^/]*/' "$1" | sort -u | while IFS= read -r d; do
        [ -f "$d/index.theme" ] && gtk-update-icon-cache -q -t -f "$d" 2>/dev/null; true
    done
    grep -q '/share/glib-2.0/schemas/' "$1" && glib-compile-schemas "$PREFIX/share/glib-2.0/schemas" 2>/dev/null
    grep -q '/share/applications/' "$1" && update-desktop-database -q "$PREFIX/share/applications" 2>/dev/null
    grep -q '/share/mime/packages/' "$1" && update-mime-database "$PREFIX/share/mime" 2>/dev/null
    true
}

record() { # ATOM URL REQUIRES EXPLICIT(0/1) [VERSION]
    local dir; dir=$(dbdir "$1")
    { echo "url=$2"; echo "requires=$3"; echo "version=${5:-}"; echo "date=$(date +%F)"; } > "$dir/info"
    if [ "$4" = 1 ]; then touch "$dir/explicit"; fi
}

install_atom() { # ATOM EXPLICIT
    local a=$1 url sha bs ca req ver sd ma pg cf svc
    ver=$(recipe_get "$PORTS/$a/recipe" version)
    sd=$(recipe_get "$PORTS/$a/recipe" srcdir)
    ma=$(recipe_get "$PORTS/$a/recipe" make_args)
    pg=$(recipe_get "$PORTS/$a/recipe" programs)
    cf=$(recipe_get "$PORTS/$a/recipe" cflags)
    url=$(recipe_get "$PORTS/$a/recipe" url)
    sha=$(recipe_get "$PORTS/$a/recipe" sha256)
    bs=$(recipe_get "$PORTS/$a/recipe" build)
    ca=$(recipe_get "$PORTS/$a/recipe" configure_args)
    req=$(requires_of "$a")
    say "installing $a${ver:+ $ver}"
    if [ -z "$url" ]; then # meta-package: only dependencies
        mkdir -p "$(dbdir "$a")"; : > "$(dbdir "$a")/files"; record "$a" "" "$req" "$2" "$ver"; return 0
    fi
    newwork
    # cflags: extra C compiler flags for this port only (old C code: -std=gnu17, -Wno-error=...)
    if [ -n "$cf" ]; then
        CFLAGS="${CFLAGS:--O2 -g} $cf" build_and_stage "$a" "$url" "$sha" "$bs" "$ca" "$PORTS/$a" "$sd" "$ma" "$pg"
    else
        build_and_stage "$a" "$url" "$sha" "$bs" "$ca" "$PORTS/$a" "$sd" "$ma" "$pg"
    fi
    merge "$a"
    record "$a" "$url" "$req" "$2" "$ver"
    rm -rf "$WORK"; WORK=''
    if [ -d "$PORTS/$a/dinit" ]; then
        for svc in "$PORTS/$a"/dinit/*; do [ -f "$svc" ] && say "service ${svc##*/} installed: dinitctl enable ${svc##*/}"; done
    fi
}

# ---- commands ----
cmd_install() {
    [ $# -ge 1 ] || die "usage: get install NAME..."
    need_root "installing"
    local x a want=''
    for x in "$@"; do
        case "$x" in
            *://*) # a plain tarball: tracked under its file name
                local f=${x%%[?#]*}; f=${f##*/}; local key=url/${f%%.tar*}; key=${key%.tgz}
                newwork; build_and_stage "" "$x" "" "" ""; merge "$key"; record "$key" "$x" "" 1; rm -rf "$WORK"; WORK=''
                say "$key installed"; continue ;;
        esac
        a=$(atom "$x")
        if installed "$a" && [ "$FORCE" = 0 ]; then printf 'get: %s is already installed (get install -f %s rebuilds it)\n' "$a" "$x"; touch "$(dbdir "$a")/explicit"; continue; fi
        if provided_by_base "$a" && [ "$FORCE" = 0 ]; then printf 'get: %s is part of the base system (get install -f %s builds it anyway)\n' "$a" "$x"; continue; fi
        want="$want $a"
    done
    [ -n "$want" ] || return 0
    ORDER='' VISITING=''
    for a in $want; do visit "$a"; done
    say "$(echo $ORDER | wc -w) package(s) to build:$ORDER"
    for a in $ORDER; do
        case " $want " in *" $a "*) install_atom "$a" 1 ;; *) install_atom "$a" 0 ;; esac
    done
    say "done"
}

# needed_by ATOM: installed packages that require ATOM
needed_by() {
    local a=$1 p r
    for p in $(installed_atoms); do
        [ "$p" = "$a" ] && continue
        for r in $(sed -n 's/^requires=//p' "$(dbdir "$p")/info" 2>/dev/null); do
            case "$r" in */*) ;; *) r=$(atom "$r" 2>/dev/null || echo "$r") ;; esac
            [ "$r" = "$a" ] && { echo "$p"; break; }
        done
    done
}

remove_atom() {
    local a=$1 dir f d users
    dir=$(dbdir "$a")
    installed "$a" || die "$a is not installed"
    case "$a" in base/*) [ "$FORCE" = 1 ] || die "$a is part of the base system (use -f to remove it anyway)" ;; esac
    if [ -f "$dir/replaces" ] && [ "$FORCE" = 0 ]; then
        die "$a replaced the base system's ${a##*/}; removing it would leave the system without it (use -f to remove anyway)"
    fi
    users=$(needed_by "$a" | tr '\n' ' ')
    if [ -n "$users" ] && [ "$FORCE" = 0 ]; then die "$a is needed by: $users(remove those first, or use -f)"; fi
    say "removing $a"
    while IFS= read -r f; do rm -f "$f"; done < "$dir/files"
    refresh_caches "$dir/files"
    # drop directories the package left empty (never the prefix itself)
    sed 's|/[^/]*$||' "$dir/files" | sort -ur | while IFS= read -r d; do
        # never the top two levels (/usr/share, /etc/dinit.d, ...)
        while [ "$(tr -cd / <<< "$d" | wc -c)" -gt 2 ] && rmdir "$d" 2>/dev/null; do d=${d%/*}; done
    done
    rm -rf "$dir"
}

cmd_remove() {
    [ $# -ge 1 ] || die "usage: get remove NAME..."
    need_root "removing"
    local x a
    for x in "$@"; do
        case "$x" in url/*|base/*) a=$x ;; *) a=$(atom "$x" 2>/dev/null || true); [ -n "$a" ] || a=$(installed_atoms | grep "/$x\$" | head -n1) ;; esac
        [ -n "$a" ] || die "$x is not installed"
        remove_atom "$a"
    done
    ldconfig 2>/dev/null || true
    say "done"
}

cmd_autoremove() {
    need_root "removing"
    local changed=1 p any=0
    while [ "$changed" = 1 ]; do
        changed=0
        for p in $(installed_atoms); do
            [ -f "$(dbdir "$p")/explicit" ] && continue
            [ -z "$(needed_by "$p")" ] || continue
            remove_atom "$p"; changed=1; any=1
        done
    done
    ldconfig 2>/dev/null || true
    [ "$any" = 1 ] && say "done" || echo "get: nothing to remove"
}

cmd_list() {
    local p v
    for p in $(installed_atoms); do
        v=$(sed -n 's/^version=//p' "$(dbdir "$p")/info" 2>/dev/null)
        if [ -f "$(dbdir "$p")/explicit" ]; then echo "* $p${v:+ $v}"; else echo "  $p${v:+ $v}"; fi
    done
}

cmd_search() {
    [ $# -eq 1 ] || die "usage: get search WORD"
    [ -d "$PORTS" ] || die "no ports tree in $PORTS (try: get sync)"
    # matches in the name or the description
    (cd "$PORTS" && { ls -d */*/ | sed 's|/$||' | grep -i -- "$1" || true; grep -lis -- "^description=.*$1" */*/recipe | sed 's|/recipe$||' || true; } | sort -u) |
    while IFS= read -r a; do
        local d tag=''
        d=$(recipe_get "$PORTS/$a/recipe" description)
        if installed "$a"; then tag=' [installed]'; elif provided_by_base "$a"; then tag=' [base system]'; fi
        printf '%s%s%s\n' "$a" "$tag" "${d:+  - $d}"
    done
}

cmd_info() {
    [ $# -eq 1 ] || die "usage: get info NAME"
    local a; a=$(atom "$1")
    echo "package:  $a"
    sed 's/^/  /' "$PORTS/$a/recipe"
    if installed "$a"; then echo "status:   installed $(sed -n 's/^date=//p' "$(dbdir "$a")/info" 2>/dev/null) ($(wc -l < "$(dbdir "$a")/files") files)"
    elif provided_by_base "$a"; then echo "status:   part of the base system"
    else echo "status:   not installed"; fi
    local u; u=$(needed_by "$a" | tr '\n' ' '); [ -z "$u" ] || echo "needed by: $u"
}

cmd_files() {
    [ $# -eq 1 ] || die "usage: get files NAME"
    local a; a=$(atom "$1" 2>/dev/null || echo "$1")
    installed "$a" || die "$1 is not installed"
    cat "$(dbdir "$a")/files"
}

cmd_sync() {
    if git -C "$PORTS" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        die "$PORTS is part of a git checkout: update it with git pull"
    fi
    need_root "updating the ports tree"
    command -v tar >/dev/null && command -v sha256sum >/dev/null || die "tar and sha256sum are required"
    newwork
    say "downloading the ports tree"
    quietfetch "$PORTS_URL" "$WORK/ports.tar.xz" || die "cannot download $PORTS_URL"
    quietfetch "$PORTS_URL.sha256" "$WORK/ports.sha256" || die "cannot download the ports checksum"
    [ "$(sed -n '1s/[[:space:]].*//p' "$WORK/ports.sha256")" = "$(sha256sum "$WORK/ports.tar.xz" | cut -d' ' -f1)" ] || die "ports checksum mismatch"
    mkdir -p "$WORK/new"
    tar --no-same-owner -xJf "$WORK/ports.tar.xz" -C "$WORK/new" --strip-components=1 || die "extracting ports failed"
    [ -n "$(ls "$WORK/new")" ] || die "the downloaded ports tree is empty"
    mkdir -p "$PORTS" && rm -rf "${PORTS:?}"/* && cp -a "$WORK/new/." "$PORTS/" || die "cannot update $PORTS"
    say "ports tree updated: $(cd "$PORTS" && ls -d */*/ | wc -l) packages"
}

# get profile NAME: unpack a prebuilt profile (and the profiles it requires) published with the release
DONE=''
install_profile() {
    case "$1" in ''|*[!A-Za-z0-9_-]*) die "invalid profile name: $1" ;; esac
    case " $DONE " in *" $1 "*) return 0 ;; esac
    DONE="$DONE $1"
    say "profile $1"
    local t=$WORK/profile-$1
    if ! quietfetch "$BASE/profile-$1.tar.xz" "$t.tar.xz"; then
        [ -z "${2:-}" ] || { printf 'get: warning: required profile %s not published, skipping\n' "$1" >&2; return 0; }
        die "cannot download profile $1 from $BASE"
    fi
    quietfetch "$BASE/profile-$1.tar.xz.sha256" "$t.sha256" || die "cannot download the checksum of profile $1"
    [ "$(sed -n '1s/[[:space:]].*//p' "$t.sha256")" = "$(sha256sum "$t.tar.xz" | cut -d' ' -f1)" ] || die "checksum mismatch for profile $1"
    if quietfetch "$BASE/profile-$1.requires" "$t.requires" 2>/dev/null; then
        local req; for req in $(cat "$t.requires"); do install_profile "$req" optional; done
    fi
    tar -xJf "$t.tar.xz" -C / || die "extracting profile $1 failed"
}
cmd_profile() {
    [ $# -eq 1 ] || die "usage: get profile NAME"
    need_root "installing a profile"
    BASE=${GET_PROFILE_URL:-}
    if [ -z "$BASE" ]; then
        local ver; ver=$(cat /usr/share/systemlinux/image-version 2>/dev/null) || die "no image version found (set GET_PROFILE_URL)"
        BASE=https://github.com/tortr-rs/systemLinux/releases/download/v$ver
    fi
    newwork
    install_profile "$1"
    ldconfig 2>/dev/null || true
    say "profile $1 installed"
}

# ---- options and command ----
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        -f|--force) FORCE=1 ;;
        -k|--keep) KEEP=1 ;;
        -j) [ $# -ge 2 ] || die "-j needs a number"; JOBS=$2; shift ;;
        -j*) JOBS=${1#-j} ;;
        -h|--help) usage; exit 0 ;;
        --sync) ARGS+=(sync) ;;                              # old spelling
        -P|--profile) ARGS+=(profile) ;;                     # old spelling
        -*) die "unknown option $1 (see get --help)" ;;
        *) ARGS+=("$1") ;;
    esac
    shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
[ $# -ge 1 ] || { usage; exit 2; }
case "${JOBS:-x}" in x) JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1) ;; *[!0-9]*) die "-j needs a number" ;; esac
# packages installed under the prefix are found by later builds
export PKG_CONFIG_PATH="$PREFIX/lib64/pkgconfig:$PREFIX/lib/pkgconfig:$PREFIX/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export PATH="$PREFIX/bin:$PATH"

CMD=$1; shift
case "$CMD" in
    install|i|add)            cmd_install "$@" ;;
    remove|rm|uninstall|del)  cmd_remove "$@" ;;
    autoremove)               cmd_autoremove ;;
    list|ls)                  cmd_list ;;
    search|s)                 cmd_search "$@" ;;
    info|show)                cmd_info "$@" ;;
    files)                    cmd_files "$@" ;;
    sync|update)              cmd_sync ;;
    profile)                  cmd_profile "$@" ;;
    help)                     usage ;;
    *)                        set -- "$CMD" "$@"; CMD=install; cmd_install "$@" ;;   # `get NAME` = install
esac
