#!/bin/sh
# Upgrade an installed systemLinux to a newer release, with rollback.
#
# The system is a read-only image (/boot/images/<version>/rootfs.squashfs) with everything you change
# (files, accounts, settings, packages built with `get`) in /persist/upper on top. An upgrade only adds the new
# release's image next to the old one and makes it GRUB's default: your changes carry over, and the old version
# stays in the GRUB menu. If the new one misbehaves, pick the old entry at boot (or `systemlinux-upgrade
# --rollback`). Nothing changes on the running system until you reboot.
#
# usage: systemlinux-upgrade               download and install the latest release
#        systemlinux-upgrade --check       only say whether a newer release exists
#        systemlinux-upgrade --iso FILE    install from a systemLinux ISO you already have
#        systemlinux-upgrade --rollback    make the previous version the default again
#        systemlinux-upgrade --list        the installed versions
# Old images beyond the newest KEEP (default 3) are removed, never the one that is running.
set -eu
REPO=tortr-rs/systemLinux
KEEP=${KEEP:-3}
DATA=/data
IMAGES=$DATA/boot/images
die() { echo "systemlinux-upgrade: $*" >&2; exit 1; }
say() { echo "== $*"; }

CURRENT=$(cat /usr/share/systemlinux/image-version 2>/dev/null || true)
[ -n "$CURRENT" ] || die "no /usr/share/systemlinux/image-version: is this systemLinux?"
installed() { ls -1 "$IMAGES" 2>/dev/null | grep -v '\.part$' | while read -r v; do [ -f "$IMAGES/$v/rootfs.squashfs" ] && echo "$v"; done | sort -V; }
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }   # newer A B: A > B

# the boot parameters of the running system tell where the data partition is
cmdline=$(cat /proc/cmdline)
DUUID=$(echo "$cmdline" | tr ' ' '\n' | sed -n 's/^systemlinux\.data=UUID=//p')
regrub() {
    LUKS=$(cat "$DATA/boot/luks-uuid" 2>/dev/null || true)
    /usr/local/bin/systemlinux-grubcfg "$DATA/boot" "$DUUID" $LUKS
    grub-editenv "$DATA/boot/grub/grubenv" create 2>/dev/null || true
    grub-set-default --boot-directory="$DATA/boot" "$1"
}
# The identity files (/etc/os-release, /etc/issue, /etc/release, the login banner) are in every image, with that
# image's version; the installer also wrote copies into /persist/upper, which would show the old version on top of
# any newer image. Remove those copies so each image shows its own. Takes effect at the next boot.
unbrand() {
    for f in etc/os-release etc/issue etc/release etc/profile.d/systemlinux.sh; do rm -f "$DATA/persist/upper/$f"; done
}
need_installed() {
    [ -n "$DUUID" ] && [ -d "$IMAGES" ] || die "this is not an installed systemLinux (live system? install it with systemlinux-install)"
    [ "$(id -u)" = 0 ] || die "must run as root (sudo systemlinux-upgrade)"
}
latest() {
    curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1
}

case "${1:-}" in
    --list)
        for v in $(installed); do
            m=; [ "$v" = "$CURRENT" ] && m=" (running)"
            echo "$v$m"
        done; exit 0 ;;
    --check)
        L=$(latest) || die "cannot reach GitHub"
        [ -n "$L" ] || die "no release found"
        if newer "$L" "$CURRENT"; then echo "systemLinux $L is available (running $CURRENT): sudo systemlinux-upgrade"
        else echo "systemLinux $CURRENT is the latest release"; fi
        exit 0 ;;
    --rollback)
        need_installed
        PREV=$(installed | grep -vx "$CURRENT" | tail -1)
        [ -n "$PREV" ] || die "no other version installed to roll back to"
        regrub "$PREV"
        unbrand
        say "systemLinux $PREV is the default again; reboot to use it ($CURRENT stays in the menu)"
        exit 0 ;;
    --iso) ISO=${2:?--iso needs a file}; [ -f "$ISO" ] || die "$ISO: no such file" ;;
    '') ISO= ;;
    -h|--help) sed -n '9,15p' "$0"; exit 0 ;;
    *) die "unknown option $1 (see --help)" ;;
esac
need_installed

W=$IMAGES/.upgrade
cleanup() { umount "$W/sq" 2>/dev/null || true; umount "$W/iso" 2>/dev/null || true; rm -rf "$W"; }
trap cleanup EXIT INT TERM
rm -rf "$W"; mkdir -p "$W/iso" "$W/sq"

if [ -z "$ISO" ]; then
    say "checking for a new release"
    NEW=$(latest) || die "cannot reach GitHub"
    [ -n "$NEW" ] || die "no release found"
    newer "$NEW" "$CURRENT" || { echo "systemLinux $CURRENT is the latest release, nothing to do"; exit 0; }
    NAME=systemLinux-$NEW-x86_64.iso
    URL=https://github.com/$REPO/releases/download/v$NEW
    say "downloading systemLinux $NEW"
    curl -fL --progress-bar -o "$W/$NAME" "$URL/$NAME" || die "download failed"
    curl -fsSL -o "$W/$NAME.sha256" "$URL/$NAME.sha256" || die "cannot download the checksum"
    (cd "$W" && sha256sum -c "$NAME.sha256" >/dev/null) || die "checksum mismatch: the download is damaged, try again"
    ISO=$W/$NAME
fi

mount -o loop,ro "$ISO" "$W/iso" || die "cannot open $ISO"
for f in vmlinuz initrd.img rootfs.squashfs; do [ -f "$W/iso/live/$f" ] || die "$ISO is not a systemLinux ISO (no live/$f)"; done
# the image's version, from inside the image itself
NEW=
if mount -t squashfs -o loop,ro "$W/iso/live/rootfs.squashfs" "$W/sq" 2>/dev/null; then
    NEW=$(cat "$W/sq/usr/share/systemlinux/image-version" 2>/dev/null || true)
    umount "$W/sq"
fi
[ -n "$NEW" ] || NEW=$(echo "${ISO##*/}" | sed -n 's/^systemLinux-\(.*\)-x86_64\.iso$/\1/p')
[ -n "$NEW" ] || die "cannot tell which version $ISO is"
[ "$NEW" != "$CURRENT" ] || die "systemLinux $NEW is already running"
[ -f "$IMAGES/$NEW/rootfs.squashfs" ] && die "systemLinux $NEW is already installed (pick it in GRUB, or: grub-set-default --boot-directory=/data/boot $NEW)"

need=$(du -sk "$W/iso/live" | cut -f1)
free=$(df -Pk "$IMAGES" | awk 'NR==2 {print $4}')
[ "$free" -gt $((need + 102400)) ] || die "not enough space on the data partition (need $((need / 1024)) MiB)"

say "installing systemLinux $NEW next to $CURRENT"
rm -rf "$IMAGES/$NEW.part"; mkdir -p "$IMAGES/$NEW.part"
for f in vmlinuz initrd.img rootfs.squashfs; do cp "$W/iso/live/$f" "$IMAGES/$NEW.part/$f"; done
sync
mv "$IMAGES/$NEW.part" "$IMAGES/$NEW"

unbrand

say "making $NEW the default"
regrub "$NEW"

# keep the newest KEEP images, and always the running one
for v in $(installed | head -n -"$KEEP"); do
    [ "$v" = "$CURRENT" ] || [ "$v" = "$NEW" ] && continue
    say "removing old image $v"; rm -rf "${IMAGES:?}/$v"
done
regrub "$NEW" >/dev/null

echo
echo "systemLinux $NEW is installed. Reboot to start it."
echo "$CURRENT stays in the GRUB menu: if anything is wrong, pick it at boot, or run: sudo systemlinux-upgrade --rollback"
