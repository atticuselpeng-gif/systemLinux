/* Symbol versions match the real libsystemd, so binaries linked against it resolve against the stub. */
LIBSYSTEMD_209 {
global:
        sd_booted; sd_notify; sd_listen_fds; sd_is_socket;
        sd_journal_send; sd_journal_sendv; sd_journal_stream_fd;
        sd_journal_open; sd_journal_open_directory; sd_journal_close; sd_journal_add_match;
        sd_journal_flush_matches; sd_journal_seek_tail; sd_journal_next; sd_journal_previous_skip;
        sd_journal_get_data; sd_journal_get_realtime_usec;
        sd_get_sessions; sd_uid_get_sessions; sd_uid_get_seats;
        sd_pid_get_session; sd_pid_get_unit; sd_pid_get_user_unit; sd_pid_get_slice;
        sd_pid_get_machine_name; sd_pid_get_owner_uid;
        sd_session_get_class; sd_session_get_remote_host; sd_session_get_seat; sd_session_get_tty;
        sd_session_get_uid;
        sd_login_monitor_new; sd_login_monitor_unref; sd_login_monitor_get_fd; sd_login_monitor_flush;
local:
        *;
};

LIBSYSTEMD_221 {
global:
        sd_event_loop; sd_event_exit;
} LIBSYSTEMD_209;

LIBSYSTEMD_240 {
global:
        sd_device_ref; sd_device_unref; sd_device_get_devname; sd_device_get_is_initialized;
        sd_device_get_property_value;
        sd_device_monitor_new; sd_device_monitor_unref; sd_device_monitor_start;
        sd_device_monitor_get_event; sd_device_monitor_filter_add_match_subsystem_devtype;
} LIBSYSTEMD_221;

LIBSYSTEMD_247 {
global:
        sd_event_add_time_relative;
} LIBSYSTEMD_240;

LIBSYSTEMD_248 {
global:
        sd_device_get_action;
} LIBSYSTEMD_247;

LIBSYSTEMD_251 {
global:
        sd_device_new_from_devname; sd_device_open;
} LIBSYSTEMD_248;

LIBSYSTEMD_254 {
global:
        sd_uid_get_login_time; sd_session_get_username; sd_session_get_start_time; sd_session_get_leader;
} LIBSYSTEMD_251;
